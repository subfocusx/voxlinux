#!/usr/bin/env python3
"""
voxtray — AppIndicator for the Vox dictation daemon.

Shows daemon state (idle / recording / down) in the Omarchy quickshell
tray (omarchy.tray speaks StatusNotifierItem, which AyatanaAppIndicator
provides) and offers a small menu:

- status line (model + state, disabled item)
- restart service
- quit (stop service)

from the daemon via the control socket (`status` verb).
"""

from __future__ import annotations

import json
import os
import socket
import subprocess

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")

from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import GLib, Gtk  # noqa: E402

SOCKET_NAME = "voxlinux.sock"


def socket_path() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/1000"
    return os.path.join(runtime, SOCKET_NAME)


def send_control(command: str, timeout: float = 5.0) -> str:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(timeout)
        sock.connect(socket_path())
        sock.sendall(command.encode("utf-8"))
        return sock.recv(256).decode("utf-8", "replace").strip()


def model_name() -> str:
    try:
        cfg = os.path.expanduser("~/.local/share/voxlinux/config.json")
        with open(cfg, encoding="utf-8") as fh:
            return json.load(fh).get("model") or "gigaam-v3"
    except (OSError, ValueError, AttributeError):
        return "gigaam-v3"
APP_ID = "voxlinux"
POLL_MS = 2000


def daemon_state() -> tuple[str, str]:
    """Return (state, detail): idle | recording | down."""
    try:
        reply = send_control("status").lower()
    except OSError:
        return "down", "сервис не отвечает"
    reply = reply.strip().lower()
    if "recording" in reply:
        return "recording", "идёт запись…"
    if "idle" in reply or "processing" in reply:
        return "idle", "готов"
    return "idle", reply or "готов"




def systemctl(*args: str) -> None:
    subprocess.Popen(
        ["systemctl", "--user", *args, "voxlinux"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


class Tray:
    def __init__(self) -> None:
        self.ind = AppIndicator.Indicator.new(
            APP_ID,
            "audio-input-microphone",
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.ind.set_title("Vox — диктовка")

        self.menu = Gtk.Menu()
        self.status_item = Gtk.MenuItem(label="…")
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        restart = Gtk.MenuItem(label="Перезапустить сервис")
        restart.connect("activate", lambda *_: systemctl("restart"))
        self.menu.append(restart)

        quit_item = Gtk.MenuItem(label="Выход (остановить сервис)")
        quit_item.connect("activate", self.on_quit)
        self.menu.append(quit_item)

        self.menu.show_all()
        self.ind.set_menu(self.menu)

        GLib.timeout_add(POLL_MS, self.refresh)
        self.refresh()

    def refresh(self) -> bool:
        state, detail = daemon_state()
        icon = {
            "idle": "audio-input-microphone",
            "recording": "media-record",
            "down": "action-unavailable",
        }[state]
        self.ind.set_icon_full(icon, state)
        self.ind.set_status(
            AppIndicator.IndicatorStatus.ACTIVE
            if state != "down"
            else AppIndicator.IndicatorStatus.ATTENTION
        )
        self.status_item.set_label(f"Vox [{model_name()}]: {detail}")
        return True

    def on_quit(self, *_args) -> None:
        systemctl("stop")
        Gtk.main_quit()


def main() -> int:
    Tray()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
